#!/bin/zsh
# The app that houses the coach.
#
# There is no Terminal window in front of this, which means nothing can be
# printed at you — so every way this can go wrong ends in a Mac dialog box
# instead. Same nine ideas as Start Coach.command, wrapped so it behaves like
# an application: Dock icon, no black window, quits when you quit it.

COACH="$(cd "$(dirname "$0")/../../.." && pwd)"   # the folder the app sits in
cd "$COACH" || exit 1

PORT=8787
URL="http://127.0.0.1:$PORT/"

alert() {   # the only way this app can talk to you
  local msg="${1//\"/\'}"
  /usr/bin/osascript -e "display dialog \"$msg\" with title \"The Socratic Coach\" buttons {\"OK\"} default button 1 with icon caution" >/dev/null 2>&1
}

running() { /usr/bin/curl -s -o /dev/null --max-time 1 "$URL"; }

ask() {   # a real question, because ending a session is never my call
  local msg="${1//\"/\'}"
  /usr/bin/osascript -e "display dialog \"$msg\" with title \"The Socratic Coach\" buttons {\"Not now\", \"Restart\"} default button 2" 2>/dev/null | grep -q "Restart"
}

head_sha() { /bin/cat .git/refs/heads/main 2>/dev/null || echo none; }

stop_running() {
  # Ask it to stop the civilised way; insist if it's an older build that
  # predates the Quit button.
  /usr/bin/curl -s -o /dev/null --max-time 2 -X POST -H 'Content-Type: application/json' \
    -d '{}' "${URL}quit" 2>/dev/null
  sleep 1
  running && /usr/bin/pkill -f 'coach\.py' 2>/dev/null
  sleep 1
}

open_page() {
  # A Chrome app window has no address bar or tabs, which makes this feel like
  # a thing rather than a website. Falls back to whatever browser you use.
  if [ -d "/Applications/Google Chrome.app" ]; then
    open -na "Google Chrome" --args --app="$URL" >/dev/null 2>&1 && return 0
  fi
  open "$URL"
}

# --- update FIRST, always ---------------------------------------------------
# This used to sit below the already-running check, which meant that once a
# copy was up, every relaunch took the shortcut and skipped the update. Fixes
# would arrive in the folder and never be read. Pull first, decide after.
BEFORE="$(head_sha)"
WANTED=""
if [ -d .git ]; then
  /usr/bin/git fetch --quiet origin main >/dev/null 2>&1
  WANTED="$(/usr/bin/git rev-parse origin/main 2>/dev/null)"
  /usr/bin/git pull --quiet --ff-only >/dev/null 2>&1
fi
AFTER="$(head_sha)"

# A pull can fail quietly — no network, or a local edit to a file the update
# also touches. Silence looked exactly like success for four rounds of this
# build, so a refused update now says so out loud rather than nothing at all.
if [ -n "$WANTED" ] && [ "$AFTER" != "$WANTED" ]; then
  alert "There's a newer build I couldn't install.

Usually that means no internet, or that a file I track has been edited by hand — memory/instructions.md is the likely one.

I'll carry on with the version already here (${AFTER:0:7})."
fi

if running; then
  if [ "$BEFORE" = "$AFTER" ]; then
    open_page          # same build, already thinking — just bring it back
    exit 0
  fi
  if ask "A newer build of the coach has arrived.

Restart to use it? Anything you're part-way through will end."; then
    stop_running
    if running; then
      alert "I couldn't stop the copy that's already running.

Open Activity Monitor, search for coach.py, and quit it — then open me again."
      exit 1
    fi
  else
    open_page          # his call, not mine
    exit 0
  fi
fi

# macOS guards Documents, Desktop and Downloads. An app without a developer
# signature gets refused there — silently, with EPERM — even though Terminal
# can read the very same files. Catch it here rather than letting python3
# report it as a missing file, which is what it looks like from the inside.
if [ ! -r coach.py ]; then
  case "$COACH" in
    "$HOME"/Documents/*|"$HOME"/Desktop/*|"$HOME"/Downloads/*)
      alert "macOS won't let me read my own files.

This folder is inside $(basename "$(dirname "$COACH")" 2>/dev/null || echo Documents), which macOS protects from apps that aren't signed by a registered developer. I'm not one — I'm a folder of Python you can read.

The fix is to keep the coach somewhere unguarded. Move the 'AI Education' folder to your home folder (the one with your name on it) and open me again."
      open "$HOME"
      ;;
    *)
      alert "I can't read coach.py, and it sits right next to me.

Either the file is missing, or macOS is denying access to this folder. Opening it now so you can see which."
      open "$COACH"
      ;;
  esac
  exit 1
fi

PY="$(command -v python3 2>/dev/null)"
if [ -z "$PY" ]; then
  alert "The coach is a Python program, and python3 isn't installed on this Mac yet.

Opening the Terminal and running:  xcode-select --install
will install it. It's a one-off."
  exit 1
fi

if [ ! -f .env ]; then
  alert "The coach has no keys, so it can't reach the model.

There's a file called .env.example in the folder I'm about to open. Copy it to .env and put your two Cloudflare values in it."
  open "$COACH"
  exit 1
fi

# --- start it, and watch long enough to catch a birth defect --------------
ERRLOG="$(mktemp -t coach)"
COACH_NO_BROWSER=1 "$PY" coach.py >/dev/null 2>"$ERRLOG" &
SERVER=$!

for _ in {1..40}; do
  running && break
  kill -0 "$SERVER" 2>/dev/null || break
  sleep 0.25
done

if ! running; then
  alert "The coach couldn't start.

$(/usr/bin/tail -c 700 "$ERRLOG")"
  rm -f "$ERRLOG"
  exit 1
fi

open_page
wait "$SERVER"
STATUS=$?

# A non-zero exit means it fell over mid-session rather than being quit.
if [ "$STATUS" -ne 0 ] && [ "$STATUS" -ne 143 ] && [ -s "$ERRLOG" ]; then
  alert "The coach stopped unexpectedly.

$(/usr/bin/tail -c 700 "$ERRLOG")"
fi
rm -f "$ERRLOG"
